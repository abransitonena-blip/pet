{
  "name": "pet-reservations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-forbidden.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:rules": "jest __tests__/p04-firestore-rules.emulator.test.ts __tests__/customer-onboarding-rules.emulator.test.ts __tests__/tickets-t2-rules.emulator.test.ts __tests__/chat-rules.emulator.test.ts __tests__/walker-reviews-rules.emulator.test.ts --runInBand",
    "emulator": "firebase emulators:start --only firestore --project pet-1cb0b",
    "test:rules:all": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8081} FIRESTORE_RULES_PATH=$PWD/firestore.rules TICKET_RULES_PATH=$PWD/firestore.rules WALK_REPORT_RULES_PATH=$PWD/firestore.rules jest --testPathPatterns emulator --runInBand"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/oidc": "^3.8.5",
    "clsx": "2.1.1",
    "firebase": "^10.12.0",
    "firebase-admin": "^11.11.1",
    "framer-motion": "^11.1.0",
    "google-auth-library": "^11.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0"
  }
