rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isWalker() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'walker';
    }

    function isSupervisor() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isClient() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client';
    }

    function getRole() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isWalkerAssignedToReservation() {
      return isWalker()
        && resource.data.assignment != null
        && resource.data.assignment.walkerId == request.auth.uid;
    }

    function isWalkerByNameOnReservation() {
      return isWalker()
        && resource.data.assignedWalker != null
        && resource.data.assignedWalker == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }

    function isWalkerAssignedInUpdate() {
      return isWalker()
        && request.resource.data.assignment != null
        && request.resource.data.assignment.walkerId == request.auth.uid;
    }

    function isReservationClient() {
      return isAuthenticated()
        && resource.data.client != null
        && resource.data.client.uid == request.auth.uid;
    }

    function isPetOwner() {
      return isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    function isConversationParticipant() {
      return isAuthenticated()
        && request.auth.uid in resource.data.participants;
    }

    function isNotificationOwner() {
      return isAuthenticated()
        && request.auth.uid == resource.data.uid;
    }


    // Rate limiting: reservation fields validation
    function isValidReservation() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'service', 'petName', 'date', 'time', 'client'])
        && request.resource.data.keys().size() <= 30;
    }

    // Rate limiting: review fields validation
    function isValidReview() {
      return request.resource.data.keys().size() <= 10
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    // ═══════════════════════════════════════════
    // USERS (role documents — immutable from client)
    // ═══════════════════════════════════════════

    match /users/{uid} {
      // Users can only read their own role doc
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Only Cloud Functions (admin SDK) can write roles
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // CLIENTS (profiles)
    // ═══════════════════════════════════════════

    match /clients/{uid} {
      // Owner can read, admin can read all
      allow read: if isAuthenticated()
        && (request.auth.uid == uid || isAdmin());
      // Owner creates own profile on first login
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'createdAt']);
      // Owner updates own profile, admin can update any
      allow update: if isAuthenticated()
        && (request.auth.uid == uid || isAdmin());
      // Nobody deletes client profiles
      allow delete: if false;
    }

    // ═══════════════════════════════════════════
    // PETS (dog profiles)
    // ═══════════════════════════════════════════

    match /pets/{petId} {
      // Owner reads own pets, admin reads all, walker reads assigned
      allow read: if isAuthenticated()
        && (isPetOwner() || isAdmin());
      // Owner creates own pet
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      // Owner updates own pet, admin can update any
      allow update: if isAuthenticated()
        && (isPetOwner() || isAdmin());
      // Owner deletes own pet, admin can delete any
      allow delete: if isAuthenticated()
        && (isPetOwner() || isAdmin());
    }

    // ═══════════════════════════════════════════
    // ADDRESSES (saved pickup/delivery locations)
    // ═══════════════════════════════════════════

    match /addresses/{addressId} {
      allow read: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ═══════════════════════════════════════════
    // SERVICE ORDERS (multi-session purchases)
    // ═══════════════════════════════════════════

    match /serviceOrders/{orderId} {
      allow read: if isAuthenticated()
        && (resource.data.clientId == request.auth.uid || isAdmin() || isSupervisor());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (resource.data.clientId == request.auth.uid || isAdmin() || isSupervisor());
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if isAuthenticated()
          && (resource.data.clientId == request.auth.uid
              || resource.data.walkerId == request.auth.uid
              || isAdmin()
              || isSupervisor());
        allow create: if isAuthenticated();
        allow update: if isAuthenticated()
          && (resource.data.clientId == request.auth.uid
              || resource.data.walkerId == request.auth.uid
              || isAdmin()
              || isSupervisor());
        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════
    // RESERVATIONS
    // ═══════════════════════════════════════════

    match /reservations/{resId} {
      // READ: owner, assigned walker (by uid or name), admin, supervisor
      allow read: if isAuthenticated()
        && (isReservationClient()
            || isWalkerAssignedToReservation()
            || isWalkerByNameOnReservation()
            || isAdmin()
            || isSupervisor());

      // CREATE: any authenticated user (client books, admin creates)
      allow create: if isAuthenticated()
        && isValidReservation();

      // UPDATE: admin always, walker for status transitions on assigned (by uid or name), client can cancel own pending
      allow update: if isAuthenticated()
        && (isAdmin()
            || isWalkerAssignedInUpdate()
            || (isWalker()
                && request.resource.data.assignedWalker != null
                && request.resource.data.assignedWalker == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name)
            || (isReservationClient()
                && request.resource.data.status == 'cancelled'
                && resource.data.status != 'completed'
                && resource.data.status != 'cancelled'));

      // DELETE: admin only
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // WALKERS (paseador profiles)
    // ═══════════════════════════════════════════

    match /walkers/{walkerId} {
      // All authenticated can read (for assignment display)
      allow read: if isAuthenticated();
      // Admin manages walkers
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // WALKER PROFILES (rich data: zones, schedule, capacity)
    // ═══════════════════════════════════════════

    match /walkerProfiles/{uid} {
      // All authenticated can read (client needs to see available walkers for selection)
      allow read: if isAuthenticated();
      // Only Cloud Functions can write (createWalkerAccount)
      allow write: if false;
      // Walker can update own profile (status confirmation, photo)
      allow update: if isWalker() && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════
    // ZONES (geographic zones)
    // ═══════════════════════════════════════════

    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // WALK LOGS (bitácora)
    // ═══════════════════════════════════════════

    match /walk-logs/{logId} {
      allow read: if isAuthenticated()
        && (resource.data.walkerId == request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || isAdmin());
      allow create: if isWalker() || isAdmin();
      allow update: if isWalker() || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // REVIEWS
    // ═══════════════════════════════════════════

    match /reviews/{docId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && isValidReview();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ═══════════════════════════════════════════
    // GALLERY
    // ═══════════════════════════════════════════

    match /gallery-images/{docId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAny(['url', 'base64']);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ═══════════════════════════════════════════
    // COUPONS
    // ═══════════════════════════════════════════

    match /coupons/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // ADMIN DOCUMENTS
    // ═══════════════════════════════════════════

    match /admin/prices {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin/banner {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FCM tokens: owner writes own, admin reads all
    match /admin/tokens {
      allow read: if isAdmin();
      // Only Cloud Functions should write tokens via Admin SDK
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // CONVERSATIONS + MESSAGES (Chat)
    // ═══════════════════════════════════════════

    match /conversations/{convId} {
      allow read: if isAuthenticated()
        && (isConversationParticipant() || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (isConversationParticipant() || isAdmin());
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated()
          && (isConversationParticipant() || isAdmin());
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════
    // REFERRALS
    // ═══════════════════════════════════════════

    match /referrals/{refId} {
      // Referrer sees own referrals, admin sees all
      allow read: if isAuthenticated()
        && (resource.data.referrerUid == request.auth.uid || isAdmin());
      // Authenticated users create referrals
      allow create: if isAuthenticated();
      // Only admin can update status/rewards
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // LOYALTY
    // ═══════════════════════════════════════════

    match /loyalty/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Only Cloud Functions should write loyalty
      allow write: if false;
    }

    // ═══════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════

    match /notifications/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Admin creates notifications via Cloud Functions
      allow write: if isAdmin();

      match /items/{notifId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        // Admin creates via Cloud Functions
        allow create: if isAdmin();
        // Owner can mark as read
        allow update: if isAuthenticated() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════
    // AUDIT LOGS (immutable)
    // ═══════════════════════════════════════════

    match /audit-logs/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════
    // CATCH-ALL: deny everything else
    // ═══════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
